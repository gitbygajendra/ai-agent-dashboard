# Copy to .env.local (development) or set in your host's environment (production).
# Variable names only — never commit real values.

# ---- App ----
# Public URL of this app. n8n calls back to ${APP_BASE_URL}/api/n8n/callback/:id, so n8n must be able to reach it.
APP_BASE_URL=http://localhost:3000

# ---- Database (Supabase Postgres) ----
# Supabase: Project Settings → Database → Connection string → "Transaction pooler" (port 6543).
DATABASE_URL=
# "true" for hosted Supabase.
DATABASE_SSL=false

# ---- Auth ----
# "supabase" (production) or "local" (development without a Supabase project). Defaults to supabase when the URL/key are set.
AUTH_MODE=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used for private Storage access. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=agent-files
# Only for AUTH_MODE=local: 32+ random characters (e.g. `openssl rand -base64 48`).
LOCAL_AUTH_SECRET=
# Only used when SUPABASE_SERVICE_ROLE_KEY is not set.
LOCAL_STORAGE_DIR=.data/uploads

# ---- Secrets encryption (OAuth tokens at rest) ----
# 32 random bytes, base64: `openssl rand -base64 32`
ENCRYPTION_KEY=

# ---- n8n ----
# Base URL of your n8n instance. All agents call one master workflow at ${N8N_BASE_URL}/webhook/agent-dashboard.
N8N_BASE_URL=
# "master" (default, import n8n/agent-dashboard-master.json) or "per-agent" (seven workflows).
N8N_WORKFLOW_MODE=master
# Optional: full master webhook URL if it isn't ${N8N_BASE_URL}/webhook/agent-dashboard.
N8N_MASTER_WEBHOOK_URL=
# Must match the "Agent Dashboard Webhook Secret" Header Auth credential in n8n (header x-webhook-secret).
N8N_WEBHOOK_SECRET=
# How long to wait for n8n to acknowledge a run, and how long before an unanswered run is marked timed out.
N8N_ACK_TIMEOUT_MS=15000
EXECUTION_TIMEOUT_MS=600000
# Optional per-agent overrides (full webhook URLs); take precedence in either mode.
N8N_WEBHOOK_URL_DATA_ANALYTICS=
N8N_WEBHOOK_URL_EMAIL_AUTOMATION=
N8N_WEBHOOK_URL_FINANCE_AUDIT=
N8N_WEBHOOK_URL_CRM_AUTOMATION=
N8N_WEBHOOK_URL_DATA_ADVISORY=
N8N_WEBHOOK_URL_CUSTOMER_SUPPORT=
N8N_WEBHOOK_URL_LEAD_GENERATION=

# ---- AI ----
# AI_PROVIDER: "anthropic" or "groq". The dashboard never sends the key; n8n does.
# Self-hosted n8n: start it with GROQ_API_KEY / ANTHROPIC_API_KEY in its environment and N8N_BLOCK_ENV_ACCESS_IN_NODE=false
# (scripts/start-n8n.ps1 reads them from this file). n8n Cloud: build with `npm run n8n:build -- --ai-credential`
# and add a Header Auth credential "AI API Key" (x-api-key for Anthropic, or Authorization: Bearer <key> for Groq).
AI_ENABLED=true
AI_PROVIDER=anthropic
# Default: claude-opus-5-5 for anthropic, llama-3.3-70b-versatile for groq.
AI_MODEL=
# Only read by scripts/start-n8n.ps1 (self-hosted n8n). Never used by the dashboard itself.
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# ---- Gmail (Google OAuth) ----
# Google Cloud Console → OAuth client (Web). Redirect URI: ${APP_BASE_URL}/api/integrations/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Limits ----
AGENT_RUNS_PER_MINUTE=10
MAX_UPLOAD_BYTES=5242880
MAX_DATASET_ROWS=50000
